
#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, i, j, head, size, temp;
    int request[100];
    int totalHeadMovement = 0;

    printf("Enter the number of disk requests: ");
    scanf("%d", &n);

    printf("Enter the disk size: ");
    scanf("%d", &size);

    printf("Enter the initial head position: ");
    scanf("%d", &head);

    printf("Enter the disk requests:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &request[i]);
    }

    // Sort requests in ascending order
    for(i = 0; i < n - 1; i++)
    {
        for(j = 0; j < n - i - 1; j++)
        {
            if(request[j] > request[j + 1])
            {
                temp = request[j];
                request[j] = request[j + 1];
                request[j + 1] = temp;
            }
        }
    }

    printf("\nC-SCAN Disk Scheduling\n");
    printf("Head movement sequence:\n");
    printf("%d", head);

    // Service requests towards the right
    for(i = 0; i < n; i++)
    {
        if(request[i] >= head)
        {
            totalHeadMovement += abs(request[i] - head);
            head = request[i];
            printf(" -> %d", head);
        }
    }

    // Move to the last cylinder
    totalHeadMovement += abs((size - 1) - head);
    head = size - 1;
    printf(" -> %d", head);

    // Circular jump to cylinder 0
    totalHeadMovement += size - 1;
    head = 0;
    printf(" -> %d", head);

    // Service remaining requests
    for(i = 0; i < n; i++)
    {
        if(request[i] < head + 1)
        {
            totalHeadMovement += abs(request[i] - head);
            head = request[i];
            printf(" -> %d", head);
        }
    }

    printf("\n\nTotal Head Movement = %d tracks\n",
           totalHeadMovement);

    return 0;
}
