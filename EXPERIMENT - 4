#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>

int main() {
    int src, dest;
    char buffer[100];
    ssize_t n;

    src = open("source.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (src < 0) {
        perror("Source file");
        return 1;
    }

    char text[] = "Hello World!\nFile copying using system calls.\n";
    write(src, text, strlen(text));
    close(src);

    src = open("source.txt", O_RDONLY);
    if (src < 0) {
        perror("Open source");
        return 1;
    }

    dest = open("destination.txt",
                O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (dest < 0) {
        perror("Open destination");
        close(src);
        return 1;
    }

    while ((n = read(src, buffer, sizeof(buffer))) > 0) {
        if (write(dest, buffer, n) != n) {
            perror("Write error");
            close(src);
            close(dest);
            return 1;
        }
    }

    close(src);
    close(dest);

    if (n < 0) {
        perror("Read error");
        return 1;
    }

    printf("File copied successfully!\n");
    return 0;
}
