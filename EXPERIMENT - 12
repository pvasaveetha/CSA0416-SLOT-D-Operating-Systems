
#include <stdio.h>

int main() {
    int i;
    int fork[5] = {0, 0, 0, 0, 0};

    printf("Dining Philosophers Problem\n\n");

    for (i = 0; i < 5; i++) {
        printf("Philosopher %d is thinking.\n", i + 1);

        if (fork[i] == 0 && fork[(i + 1) % 5] == 0) {
            fork[i] = 1;
            fork[(i + 1) % 5] = 1;

            printf("Philosopher %d picks up forks %d and %d.\n",
                   i + 1, i + 1, (i + 1) % 5 + 1);

            printf("Philosopher %d is eating.\n", i + 1);

            fork[i] = 0;
            fork[(i + 1) % 5] = 0;

            printf("Philosopher %d puts down the forks.\n\n", i + 1);
        } else {
            printf("Philosopher %d is waiting for forks.\n\n", i + 1);
        }
    }

    printf("Simulation completed.\n");

    return 0;
}
