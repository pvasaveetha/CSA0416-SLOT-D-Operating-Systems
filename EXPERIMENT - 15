
#include <stdio.h>
#include <string.h>

char users[10][30];
char files[10][10][30];
int fileCount[10] = {0};
int userCount = 0;

int main() {
    int choice, i, j, u;
    char username[30], filename[30];
    int found;

    while (1) {
        printf("\n--- Two-Level Directory ---\n");
        printf("1. Create User Directory\n");
        printf("2. Create File\n");
        printf("3. Display Files\n");
        printf("4. Search File\n");
        printf("5. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                if (userCount >= 10) {
                    printf("Maximum users reached!\n");
                    break;
                }

                printf("Enter username: ");
                scanf("%29s", username);

                found = 0;
                for (i = 0; i < userCount; i++) {
                    if (strcmp(users[i], username) == 0) {
                        found = 1;
                        break;
                    }
                }

                if (found) {
                    printf("User directory already exists!\n");
                } else {
                    strcpy(users[userCount], username);
                    userCount++;
                    printf("User directory created successfully.\n");
                }
                break;

            case 2:
                printf("Enter username: ");
                scanf("%29s", username);

                u = -1;
                for (i = 0; i < userCount; i++) {
                    if (strcmp(users[i], username) == 0) {
                        u = i;
                        break;
                    }
                }

                if (u == -1) {
                    printf("User directory not found!\n");
                    break;
                }

                if (fileCount[u] >= 10) {
                    printf("Directory is full!\n");
                    break;
                }

                printf("Enter filename: ");
                scanf("%29s", filename);

                found = 0;
                for (j = 0; j < fileCount[u]; j++) {
                    if (strcmp(files[u][j], filename) == 0) {
                        found = 1;
                        break;
                    }
                }

                if (found) {
                    printf("File already exists in this directory!\n");
                } else {
                    strcpy(files[u][fileCount[u]], filename);
                    fileCount[u]++;
                    printf("File created successfully.\n");
                }
                break;

            case 3:
                if (userCount == 0) {
                    printf("No user directories available.\n");
                    break;
                }

                for (i = 0; i < userCount; i++) {
                    printf("\nUser: %s\n", users[i]);

                    if (fileCount[i] == 0) {
                        printf("No files.\n");
                    } else {
                        for (j = 0; j < fileCount[i]; j++) {
                            printf("  %s\n", files[i][j]);
                        }
                    }
                }
                break;

            case 4:
                printf("Enter username: ");
                scanf("%29s", username);

                u = -1;
                for (i = 0; i < userCount; i++) {
                    if (strcmp(users[i], username) == 0) {
                        u = i;
                        break;
                    }
                }

                if (u == -1) {
                    printf("User directory not found!\n");
                    break;
                }

                printf("Enter filename to search: ");
                scanf("%29s", filename);

                found = 0;
                for (j = 0; j < fileCount[u]; j++) {
                    if (strcmp(files[u][j], filename) == 0) {
                        found = 1;
                        break;
                    }
                }

                if (found)
                    printf("File found in %s directory.\n", username);
                else
                    printf("File not found.\n");
                break;

            case 5:
                printf("Exiting program.\n");
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }

    return 0;
}
