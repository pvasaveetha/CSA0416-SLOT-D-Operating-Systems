
#include <stdio.h>

void thread1() {
    int i;
    for (i = 1; i <= 5; i++) {
        printf("Thread 1: %d\n", i);
    }
}

void thread2() {
    int i;
    for (i = 1; i <= 5; i++) {
        printf("Thread 2: %d\n", i);
    }
}

int main() {
    printf("Multithreading Simulation in C\n\n");

    thread1();
    thread2();

    printf("\nExecution completed.\n");

    return 0;
}
